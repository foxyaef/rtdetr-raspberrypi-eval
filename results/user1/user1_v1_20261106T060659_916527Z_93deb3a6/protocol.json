{
  "model": "official RT-DETR v1 R50-vd COCO pretrained, unchanged",
  "source_split": "COCO 2017 val",
  "seed": 42,
  "calibration_images": 512,
  "evaluation_images": 500,
  "evaluation_pool_images": 1000,
  "evaluation_selection": "first_n_by_filename_from_pinned_evaluation_pool",
  "input_size": 640,
  "color": "RGB",
  "resize": "bilinear",
  "input_range": "0..1",
  "category_count": 80,
  "bbox_format": "xywh (COCO predictions)",
  "score_threshold_for_precision_recall": 0.5,
  "runtime_batch_size": 1,
  "runtime_warmup_images": 10,
  "runtime_latency_percentiles": [
    50,
    95
  ],
  "runtime_warmup_policy": "Separate warmup pass followed by all selected evaluation images",
  "runtime_latency_repeats_default": 1,
  "runtime_cpu_threads_default": 4,
  "evaluation_provider": "CPUExecutionProvider",
  "onnxruntime_version": "1.22.1",
  "resource_sampling_seconds": 0.02,
  "power_measurement": "null without external hardware"
}
